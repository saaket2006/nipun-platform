{
  "hosting": {
    "public": "frontend",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "!**/*.@(js|css|json|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|map)",
        "destination": "/index.html"
      }
    ]
  }
}
